# Kopyala: cp .env.example .env  — sonra kendi anahtarlarını yaz. .env asla commit edilmez.
# Yorumları ayrı satırda tut: meme_scan.py "=" sonrasını olduğu gibi okur.

# https://dashboard.helius.dev (ücretsiz). Boşsa yavaş public RPC kullanılır.
HELIUS_API_KEY=
# https://www.solanatracker.io/data-api (ücretsiz, 2.5K istek/ay)
SOLANATRACKER_API_KEY=
# Opsiyonel: X cookie'leri (auth_token, ct0) — sadece Telegram taramasındaki mutual kontrolü için
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
